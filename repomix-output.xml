            </div>
            <div v-else>
              <div
                v-if="roomsResult.length == 0"
                class="text-center d-flex align-items-center justify-content-center mb-2 alert-state warning"
                role="alert"
              >
                <i class="mdi mdi-alert-circle-outline"></i>
