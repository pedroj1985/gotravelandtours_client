                <button
                  type="submit"
                  @click="searchResult"
                  class="lodging-searchButton antonio-regular"
                >
                  <template v-if="!isReserving">Buscar</template>
                  <span
                    class="gtt-spinner gtt-spinner-sm loading-spinner"
                    v-else
                  ></span>
