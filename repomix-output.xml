<script>
import VueSlider from "vue-slider-component";
import "vue-slider-component/theme/antd.css";
export default {
  components: {
    VueSlider
  },
  watch: {
    value: function(value) {
      this.updateValue(value);
    }
  },
  props: {
    label: {
      default: "Nombre"
    },
    value: {
      type: Array
    },
    min: {
      type: Number,
      default: 0
