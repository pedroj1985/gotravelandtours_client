<script>
export default {
  name: "GttModal",
  props: {
    show: {
      type: Boolean,
      required: true
    },
    title: {
      type: String,
      default: ""
    }
  },
  methods: {
    onKeydown(e) {
      if (e.key === "Escape" && this.show) {
        this.$emit("close");
      }
    }
  },
  mounted() {
    document.addEventListener("keydown", this.onKeydown);
  },
  beforeDestroy() {
    document.removeEventListener("keydown", this.onKeydown);
  }
};
</script>

