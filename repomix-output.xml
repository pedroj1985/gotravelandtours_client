import { scrollStore } from "../../stores/scrollStore";

export default {
  name: "NavBar2",
  props: {
    menuLinks: Array
  },
  data() {
    return {
      linkSelected: "index"
    };
  },
  methods: {
    changeSelected(item) {
      this.linkSelected = item;
    },
    setLinkSelected(item) {
      if (this.linkSelected == item) {
        return false;
      }
      return true;
    }
  },
  computed: {
    activeSection() {
      return scrollStore.activeSection;
    }
  },
  watch: {
    activeSection(section) {
      this.changeSelected(section);
    }
  },
  mounted() {
    let id = this.$route.params.idPage;
    if (id) {
      let elment = document.getElementById(id);
      console.log(elment);
      this.$scrollTo(elment);
    }
  }
};
</script>
