import _ from "lodash";
export default {
  components: {
    RentResultList,
    GttSelect
  },
  computed: {
    totalPages() {
      return Math.ceil(this.total / this.perPage);
    }
  },
  watch: {
    selectedOrganizeType: function(val) {
      if (val.code == "price_desc") {
        this.currentList = _.orderBy(
          this.currentList,
          function(o) {
            return o.precio;
          },
          "desc"
        );
      } else {
        this.currentList = _.orderBy(
          this.currentList,
          function(o) {
            return o.precio;
          },
          "asc"
        );
      }
    }
  },
  created() {
    this.filter = JSON.parse(localStorage.getItem("searchRentFilters"));
  },
  data() {
    return {
      total: 1,
      currentList: [],
      currentPage: 1,
      filter: Object,
      selectedOrganizeType: {
        displayName: "Precio (asc)",
        code: "price_asc"
      },

      organizedBy: [
        {
          displayName: "Precio (asc)",
